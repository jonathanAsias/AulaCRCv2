{{!
    @template theme_aulav2/header
    Mockup header: GOV.CO + CRC logo + Moodle primary navigation.
}}
<header class="aulav2-site-header" role="banner">
    <div class="aulav2-govco-bar">
        <div class="aulav2-wrap aulav2-govco-bar__inner">
            <img class="aulav2-govco-bar__logo" src="{{home.pix.govco_logo}}" alt="gov.co">
        </div>
    </div>

    <div class="aulav2-brand">
        <div class="aulav2-wrap aulav2-brand__inner">
            <button class="navbar-toggler aabtn aulav2-hamburg d-md-none"
                data-toggler="drawers"
                data-action="toggle"
                data-target="theme_boost-drawers-primary"
                aria-label="{{#str}}sidepanel, core{{/str}}">
                <span class="navbar-toggler-icon" aria-hidden="true"></span>
            </button>
            <a class="aulav2-brand__link" href="{{config.wwwroot}}/" aria-label="{{sitename}}">
                {{#home.header_logo_url}}
                    <img class="aulav2-brand__uploaded" src="{{home.header_logo_url}}" alt="{{sitename}}">
                {{/home.header_logo_url}}
                {{^home.header_logo_url}}
                    <img class="aulav2-brand__crest" src="{{home.pix.crc_crest}}" alt="">
                    <span class="aulav2-brand__wordmark">
                        <img src="{{home.pix.crc_text}}" alt="CRC">
                        <img src="{{home.pix.crc_sub}}" alt="{{#str}}footer_crc_fullname, theme_aulav2{{/str}}">
                    </span>
                {{/home.header_logo_url}}
            </a>
        </div>
    </div>

    <nav class="aulav2-mainnav" aria-label="{{#str}}sitemenubar, admin{{/str}}">
        <div class="aulav2-wrap aulav2-mainnav__inner">
            {{#primarymoremenu}}
                <div class="primary-navigation aulav2-primary-nav d-none d-md-flex flex-grow-1">
                    {{> core/moremenu}}
                </div>
            {{/primarymoremenu}}

            <div class="aulav2-mainnav__actions">
                <a class="aulav2-mainnav__cta d-none d-md-inline" href="{{home.webcrc_url}}" target="_blank" rel="noopener">{{#str}}nav_webcrc, theme_aulav2{{/str}}</a>
                {{{ output.edit_switch }}}
                {{#langmenu}}
                    {{> theme_boost/language_menu }}
                {{/langmenu}}
                {{{ output.navbar_plugin_output }}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{#usermenu}}
                        {{> core/user_menu }}
                    {{/usermenu}}
                </div>
            </div>
        </div>
    </nav>
</header>
{{> theme_boost/primary-drawer-mobile }}
